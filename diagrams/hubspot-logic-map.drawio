        <mxCell id="operator-notes" value="operator-notes" parent="0" />
        <mxCell id="pg-04-entry-c-1" value="&lt;div style=&#x27;line-height:13px&#x27;&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;04 · Entry points — every trigger, resolved&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8A5300&quot;&gt;THE BIG STAGE-2 WIN. The 1 Sep cache could only see property and list criteria, so 201 of 767 flows showed no trigger at all and no &amp;quot;nothing triggers X&amp;quot; claim was safe.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1F6E43&quot;&gt;&lt;b&gt;Reading live definitions resolves the trigger for ALL 510 enabled flows. Zero unknowns.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fillColor=#FAFAFA;strokeColor=#BBBBBB;strokeWidth=1;fontSize=12;" vertex="1" parent="generated"><mxGeometry x="40" y="-150" width="1700" height="120" as="geometry" /></mxCell>
        <mxCell id="pg-04-entry-c-2" value="&lt;div style=&#x27;line-height:13px&#x27;&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;Forms&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1F6E43&quot;&gt;&lt;b&gt;80 distinct forms trigger a flow&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;123 form→flow trigger edges&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;175 forms exist in the portal&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;109 forms are NOT used by any flow&lt;/font&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fillColor=#E9E0F7;strokeColor=#1F6E43;strokeWidth=3;dashed=0;fontSize=11;" vertex="1" parent="generated"><mxGeometry x="40" y="20" width="405" height="160" as="geometry" /></mxCell>
        <mxCell id="pg-04-entry-c-3" value="&lt;div style=&#x27;line-height:13px&#x27;&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;Landing pages&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1F6E43&quot;&gt;&lt;b&gt;159 distinct pages trigger a flow&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;FORM_SUBMISSION_ON_PAGE criteria&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;a page id with no form id is common —&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;treating it as &amp;#x27;no trigger&amp;#x27; is the bug stage 2 fixed&lt;/font&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fillColor=#E9E0F7;strokeColor=#1F6E43;strokeWidth=3;dashed=0;fontSize=11;" vertex="1" parent="generated"><mxGeometry x="465" y="20" width="405" height="160" as="geometry" /></mxCell>
