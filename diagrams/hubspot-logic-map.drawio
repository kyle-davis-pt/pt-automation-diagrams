        <mxCell id="pg-04-entry-c-5" value="&lt;div style=&#x27;line-height:13px&#x27;&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;Unified events&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1F6E43&quot;&gt;&lt;b&gt;246 flows are EVENT_BASED&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;eventTypeId + operator, e.g. HAS_COMPLETED&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;covers meetings, bootcamp attendance, webinars&lt;/font&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fillColor=#E9E0F7;strokeColor=#1F6E43;strokeWidth=3;dashed=0;fontSize=11;" vertex="1" parent="generated"><mxGeometry x="1315" y="20" width="405" height="160" as="geometry" /></mxCell>
